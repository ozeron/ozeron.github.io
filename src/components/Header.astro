---
import Logo from './Logo.astro'
import Nav from './Nav.astro'

const { current = '' } = Astro.props;
---

<style>
  header {
    display: flex;
    align-items: center;
    justify-content: space-between; /* Separate logo and nav */
    margin: 0 auto;
    max-width: var(--container-width);
    padding: 2em 1em; /* Match BaseLayout padding */
    width: 100%;
  }
</style>

<header>
  <Logo />
  <Nav current={current} />
</header>
