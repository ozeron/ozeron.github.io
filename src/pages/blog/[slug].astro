---
import { getCollection, render } from 'astro:content'
import readingTime from 'reading-time'
import BaseLayout from '../../layouts/BaseLayout.astro';
import Bio from '../../components/Bio.astro';

export async function getStaticPaths() {
	const posts = await getCollection('posts')
  return posts.map(p => ({
    params: { slug: p.data.slug },
    props: { post: p },
  }));
}

const { post } = Astro.props
const { title, slug, description, publishDate } = post.data;
const readingTimeEstimate = readingTime(post.body).text
const permalink = `${Astro.site.href}blog/${slug}`;
const { Content } = await render(post)
---

<BaseLayout title={title} description={description} permalink={permalink}>
  <div class="container">
    <header>
      <p class="post-meta">{publishDate} ~ {readingTimeEstimate}</p>
      <h1>{title}</h1>
      <hr class="header-divider" />
    </header>
    <article class="content editorial-content">
      <Content />
    </article>
    <hr />
    <Bio />
  </div>
</BaseLayout>

<style>
  header {
    text-align: center;
    margin-bottom: 3em;
  }

  header h1 {
    font-size: 3rem;
    margin-bottom: 1em;
    margin-top: 0.5em;
    line-height: 1.1;
    letter-spacing: -0.02em;
  }

  .post-meta {
    color: var(--text-secondary);
    text-transform: uppercase;
    font-family: var(--font-family-sans);
    font-weight: 600;
    font-size: 0.85em;
    letter-spacing: 0.05em;
    margin-bottom: 1em;
  }

  .header-divider {
    width: 100px;
    margin: 2em auto;
    opacity: 0.3;
  }

  .content {
    max-width: 65ch;
    margin: 0 auto;
  }

  hr {
    margin: 4em auto;
    opacity: 0.3;
  }
</style>
