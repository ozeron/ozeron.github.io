---
import BaseLayout from '../layouts/BaseLayout.astro';

const title = 'About';
const description = 'About your blog.';
const permalink = `${Astro.site.href}about`;
---

<BaseLayout title={title} description={description} permalink={permalink} current="about">
  <div class="container">
    <h1>About</h1>
    <p>I am a Principal AI Engineer passionate about AI and building innovative products that solve real-world challenges. I focus on building high-performing teams and delivering scalable, reliable systems.</p>
  </div>
</BaseLayout>

<style>
  /* Add styles here */
</style>
